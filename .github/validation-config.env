#!/bin/bash

# Optional: Customization Configuration
# Modify these values to change validation behavior

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FILE SIZE LIMITS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Maximum size for a single file (in KB)
# Default: 500KB
# Increase for repositories with large assets
FILE_SIZE_LIMIT_KB=500

# Maximum total repository size (in MB)  
# Default: 5MB
# Increase for projects with more assets
REPO_SIZE_LIMIT_MB=5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PR DESCRIPTION REQUIREMENTS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Minimum PR description length (in characters)
# Default: 50
# Set to 0 to allow empty descriptions
MIN_PR_DESCRIPTION_LENGTH=50

# Require PR description (true/false)
# Default: false (warning only)
# Set to true to make empty description a FAIL
REQUIRE_PR_DESCRIPTION=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HTML VALIDATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Validate HTML5 DOCTYPE
VALIDATE_DOCTYPE=true

# Validate required meta tags
VALIDATE_META_TAGS=true

# Require lang attribute on html tag
REQUIRE_LANG_ATTRIBUTE=true

# Require alt attributes on all images
REQUIRE_IMAGE_ALT=true

# Check for deprecated HTML tags
CHECK_DEPRECATED_TAGS=true

# List of deprecated tags to check for
# Modify to add/remove tags based on your project
DEPRECATED_TAGS=(
    "font"
    "center"
    "marquee"
    "blink"
    "u"
    "strike"
    "applet"
    "basefont"
    "isindex"
    "keygen"
)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CODE QUALITY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Check for inline styles
CHECK_INLINE_STYLES=true

# Check for console.log statements
CHECK_CONSOLE_LOGS=true

# Check for console.error statements (can be useful for error handling)
CHECK_CONSOLE_ERRORS=false

# Check for debugger statements
CHECK_DEBUGGER=true

# Allowed inline style patterns (regex)
# Empty = forbid all inline styles
ALLOWED_INLINE_STYLES=""

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LINK VALIDATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Check internal links
CHECK_INTERNAL_LINKS=true

# Check external links (makes HTTP requests - slower)
CHECK_EXTERNAL_LINKS=false

# External link validation timeout (seconds)
EXTERNAL_LINK_TIMEOUT=5

# Paths to ignore in link checking (regex patterns)
LINK_IGNORE_PATTERNS=(
    "node_modules"
    ".git"
    ".github"
    "dist"
    "build"
)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FILE EXTENSIONS TO VALIDATE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# HTML files to validate
HTML_EXTENSIONS=("html" "htm")

# JavaScript files to validate
JS_EXTENSIONS=("js" "jsx" "ts" "tsx")

# CSS files to validate  
CSS_EXTENSIONS=("css" "scss" "sass")

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BRANCH-SPECIFIC RULES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Stricter validation for prod branch
# If true, prod branch requires more approvals and stricter checks
STRICT_PROD_VALIDATION=true

# Required approvals per branch
DEV_REQUIRED_APPROVALS=1
TEST_REQUIRED_APPROVALS=1
PROD_REQUIRED_APPROVALS=1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PR COMMENT TEMPLATE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable detailed error messages in PR comments
DETAILED_ERROR_MESSAGES=true

# Show check duration in PR comment
SHOW_CHECK_DURATION=true

# Include workflow run ID in comment
INCLUDE_RUN_ID=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# WORKFLOW BEHAVIOR
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Fail workflow if any critical check fails
# Critical = FAIL status (not WARN)
FAIL_ON_CRITICAL_ERRORS=true

# Continue checking even if one check fails
# If false, stops at first failure
CONTINUE_ON_CHECK_FAILURE=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NOTIFICATIONS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Notify on workflow completion
ENABLE_NOTIFICATIONS=true

# Slack webhook for notifications (optional)
SLACK_WEBHOOK_URL=""

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NOTES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# This is a REFERENCE FILE ONLY
# Current implementation uses hardcoded values in pr-validation.yml
#
# To customize the workflow:
# 1. Edit the JavaScript validation blocks in .github/workflows/pr-validation.yml
# 2. Look for these variables:
#    - SIZE_LIMIT (line ~380)
#    - REPO_LIMIT (line ~381)
#    - inlineStyles, console.log checks (line ~500)
#
# Future enhancement: Make workflow.yml read this config file
